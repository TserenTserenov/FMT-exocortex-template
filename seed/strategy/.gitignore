# issue #1132: scripts/update-derived-snapshot.py writes a local, rebuildable
# cache here. Not a work product — never add inbox/WP-NNN/ or any other
# RP-numbered path here, that defeats the point of moving out of inbox/.
.cache/

# issue #1146: scripts/day-open-smoke-extended.sh writes a regenerable cache here.
current/.smoke-cache.json

# issue #1201: scripts/route-task.sh keeps its journal here
# (routing-path-distribution.tsv, routing-errors.log). Runtime history lives with
# the executor, not in the governance repo; route-task.sh also adds it to the
# local .git/info/exclude of installs whose seed predates this entry.
logs/
