#!/usr/bin/env bash
# iwe-notify — one Telegram notification from a standalone IWE script
# (WP-568 Ф12 С4, ArchGate 06.11.2026, DRR: DS-my-strategy inbox/WP-568/DRR-f12.md).
#
# Usage:
#   iwe-notify --source <source-id> "text"
#   echo "text" | iwe-notify --source <source-id>
#   Python: subprocess.run([path, "--source", sid, text])  (no shell)
#   <source-id> must match [A-Za-z0-9._-]+ (it is a field of a TSV log row).
#
# Contract:
#   - A governance repo with a delivery gateway (scripts/iwe-tg) found ->
#     the message is handed to it with --source. The gateway decides the
#     channel (live chat, morning digest, quarantine for an unknown source);
#     that decision is FINAL: exit 0 (delivered/deferred), 2 (transport
#     failed after the gateway tried) and 3 (quarantined) never trigger a
#     second, direct send.
#   - Any other gateway exit (1, 4, 126/127, killed >=128): the gateway's
#     library reports through IWE_NOTIFY_STAGE_FILE how far it got (peer-session
#     2026-11-07-04). "attempt" (a request to the Bot API was started) or
#     "sent" (Telegram answered ok:true) -> a direct send could duplicate the
#     message, so none is made; the row reason is ambiguous-gateway-exit-<rc>
#     or gateway-sent-exit-<rc>. Empty stage file -> the gateway never reached
#     the network (or its last request failed before connecting), a direct
#     send is safe. No stage file at all (mktemp failed) -> ambiguous. A gateway too old to write the file
#     leaves it empty and keeps the behaviour from before this change.
#   - Every direct send and every refused ambiguous one is one row in
#     direct-send-log.tsv (UTC time, source, reason, outcome sent|failed|
#     skipped) — the morning digest counts them, so a fallback that keeps
#     firing stays visible.
#   - No gateway, no TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID -> nothing is sent,
#     exit 0 (the same as every caller's old notify_telegram()).
#   - Outcome line (peer-session 2026-11-08-06, stage 2): exactly one stdout
#     line "iwe-notify: outcome=<x>" so a caller can tell a phone delivery
#     from a digest line without a second contract with the gateway:
#       sent             gateway exit 0, its library reported stage "sent"
#       deferred         gateway exit 0 without "sent" (digest, test mode)
#       transport-failed gateway exit 2
#       quarantined      gateway exit 3
#       skipped          gateway died after starting to send; no direct send
#                        (reported as "sent" when Telegram had confirmed it)
#       direct-sent | direct-failed   own direct send (no usable gateway)
#       not-sent         no gateway delivery and no credentials / test mode
#     Exit codes are unchanged. Live callers treat only sent/direct-sent as
#     delivered; the rest keep their own exit code and log the line.
#   - --html: the text is Telegram HTML (<b>, <a>, &amp;). The direct send
#     uses parse_mode=HTML; the gateway gets plain text (tags removed,
#     entities decoded), as it sends plain text.
#   - Direct send: through TELEGRAM_PROXY (else ALL_PROXY) when set, and only
#     a reply with "ok":true counts as sent (a 200 with ok:false is failed).
#   - --reply-markup <json>: inline buttons. The gateway cannot carry them,
#     so with a gateway the text goes through it WITHOUT buttons (its verdict
#     stays final, quarantine included); only without a gateway the single
#     direct send carries the buttons.
#
# Gateway lookup: IWE_NOTIFY_GATEWAY (explicit path), else scripts/iwe-tg in
# $IWE_ROOT/$IWE_GOVERNANCE_REPO, DS-strategy, DS-my-strategy (first found).
set -uo pipefail

# Template workspaces name their root IWE_WORKSPACE; the author host IWE_ROOT.
IWE_ROOT="${IWE_ROOT:-${IWE_WORKSPACE:-$HOME/IWE}}"
LOG_DIR="${DS_PUBLISH_ADMISSION_DIR:-$IWE_ROOT/.claude/state/notify-admission}"

die_usage() { echo "iwe-notify: $1" >&2; exit 1; }

source_id=""
reply_markup=""
html=0
while [ $# -gt 0 ]; do
  case "$1" in
    --source)
      [ -n "${2:-}" ] || die_usage "--source requires a value"
      source_id="$2"; shift 2 ;;
    --source=*) source_id="${1#--source=}"; shift ;;
    --html) html=1; shift ;;
    --reply-markup)
      [ -n "${2:-}" ] || die_usage "--reply-markup requires a value"
      reply_markup="$2"; shift 2 ;;
    --) shift; break ;;
    -*) die_usage "unknown flag '$1'" ;;
    *) break ;;
  esac
done
[ -n "$source_id" ] || die_usage "--source is required"
[[ "$source_id" =~ ^[A-Za-z0-9._-]+$ ]] || die_usage "--source must match [A-Za-z0-9._-]+"
if [ $# -ge 1 ]; then msg="$1"; else msg="$(cat)"; fi
[ -n "$msg" ] || die_usage "empty message"

# plain_text: the HTML message as the gateway's plain text.
plain_text() {
  printf '%s' "$msg" | sed -e 's/<[^>]*>//g' -e 's/&lt;/</g' -e 's/&gt;/>/g' -e 's/&quot;/"/g' -e 's/&amp;/\&/g'
}

find_gateway() {
  if [ -n "${IWE_NOTIFY_GATEWAY:-}" ]; then
    printf '%s' "$IWE_NOTIFY_GATEWAY"
    return 0
  fi
  local repo
  for repo in "${IWE_GOVERNANCE_REPO:-}" DS-strategy DS-my-strategy; do
    [ -n "$repo" ] || continue
    if [ -f "$IWE_ROOT/$repo/scripts/iwe-tg" ]; then
      printf '%s' "$IWE_ROOT/$repo/scripts/iwe-tg"
      return 0
    fi
  done
  return 1
}

# log_row <reason> <outcome> — one row per bypass of the gateway, written
# after the outcome is known.
log_row() {
  mkdir -p "$LOG_DIR" 2>/dev/null \
    && printf '%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$source_id" "$1" "$2" \
      >> "$LOG_DIR/direct-send-log.tsv" 2>/dev/null \
    || echo "iwe-notify: direct-send-log.tsv not writable in $LOG_DIR" >&2
}

report() { echo "iwe-notify: outcome=$1"; }

send_direct() {
  local reason="$1" outcome=sent
  if [ -z "${TELEGRAM_BOT_TOKEN:-}" ] || [ -z "${TELEGRAM_CHAT_ID:-}" ]; then
    echo "iwe-notify: no gateway delivery ($reason) and no Telegram credentials — not sent" >&2
    report not-sent
    return 0
  fi
  # Same test-mode guard as the gateway's library (telegram_test_mode_blocked).
  if [ "${TELEGRAM_ENV:-}" = test ] && [ "${ALLOW_LIVE_TELEGRAM_IN_TEST:-}" != 1 ]; then
    echo "iwe-notify: TELEGRAM_ENV=test — direct send blocked ($reason)" >&2
    report not-sent
    return 0
  fi
  local extra=() proxy="${TELEGRAM_PROXY:-${ALL_PROXY:-}}" reply
  [ -z "$reply_markup" ] || extra+=(--data-urlencode "reply_markup=$reply_markup")
  [ "$html" -eq 0 ] || extra+=(-d "parse_mode=HTML" -d "disable_web_page_preview=true")
  [ -z "$proxy" ] || extra+=(--proxy "$proxy")
  # ${extra[@]+...}: an empty array under set -u stops bash 3.2 (macOS /bin/bash).
  reply=$(curl -sS --connect-timeout 5 --max-time 10 -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
    -d "chat_id=${TELEGRAM_CHAT_ID}" --data-urlencode "text=$msg" ${extra[@]+"${extra[@]}"}) || outcome=failed
  case "$reply" in
    *'"ok":true'*) ;;
    *) outcome=failed
       # Telegram's own reason (e.g. an HTML parse error); the reply holds no token.
       [ -z "$reply" ] || echo "iwe-notify: Telegram reply: ${reply:0:300}" >&2 ;;
  esac
  log_row "$reason" "$outcome"
  report "direct-$outcome"
  [ "$outcome" = sent ]
}

gateway="$(find_gateway)" || { send_direct "no-gateway"; exit $?; }
if [ ! -x "$gateway" ]; then
  send_direct "gateway-not-executable"
  exit $?
fi

# Without a stage file nothing tells whether the gateway reached the network,
# so a failed gateway is treated as ambiguous (no direct send) — a duplicate
# is the noise this command exists to remove.
stage_file="$(mktemp "${TMPDIR:-/tmp}/iwe-notify-stage.XXXXXX")" \
  || { stage_file=""; echo "iwe-notify: cannot create a stage file" >&2; }
trap '[ -z "$stage_file" ] || rm -f "$stage_file"' EXIT
[ -z "$reply_markup" ] \
  || echo "iwe-notify: buttons not passed — the gateway cannot carry them; text only" >&2
# "--" before the text: a message starting with "-" is text, not a flag.
# Gateway stdout goes to stderr: our stdout carries only the outcome line.
gateway_text="$msg"
[ "$html" -eq 0 ] || gateway_text="$(plain_text)"
IWE_NOTIFY_STAGE_FILE="$stage_file" "$gateway" --source "$source_id" -- "$gateway_text" >&2
rc=$?
if [ -n "$stage_file" ]; then
  stage="$(head -n 1 "$stage_file" 2>/dev/null)"
else
  stage="unknown"
fi
case "$rc" in
  0) if [ "$stage" = sent ]; then report sent; else report deferred; fi
     exit 0 ;;
  2) report transport-failed; exit 2 ;;
  3) report quarantined; exit 3 ;;
esac
case "$stage" in
  attempt|sent|unknown)
    reason="ambiguous-gateway-exit-$rc"
    [ "$stage" = sent ] && reason="gateway-sent-exit-$rc"
    echo "iwe-notify: gateway $gateway exited $rc after stage '$stage' — no direct send (it could duplicate the message)" >&2
    log_row "$reason" skipped
    # Telegram confirmed it before the gateway died: delivered, whatever the code.
    if [ "$stage" = sent ]; then report sent; else report skipped; fi
    exit "$rc" ;;
esac
echo "iwe-notify: gateway $gateway did not take the message (exit $rc) — sending directly" >&2
send_direct "gateway-exit-$rc"
