#!/usr/bin/env bash
# guarded-rm — rm that deletes only inside allowed roots (issue #940).
#
# The destructive-guard hook blocks a plain `rm` with recursion and force flags;
# instead the agent calls this script with the same arguments. At run time, when the shell
# has already expanded variables and name patterns, the script computes the canonical path
# of each target (links and `..` resolved, Windows forms `C:/…`, `/c/…`, `/tmp/…` reduced
# to one) and checks it against the roots registry at the component boundary. It deletes only if
# ALL targets lie inside the roots; the root itself, a path outside the roots, an empty target, a registry failure
# or normalization failure — refusal without deleting. Then one call of the real rm with the original
# arguments (the canonical path is only for the check).
#
# Registry: <IWE>/.claude/config/guarded-rm-roots.txt — data, not shell.
# Strict mode: any unexpected error — exit before deletion (Codex review, round 1:
# a sed failure while reading the registry did not stop the deletion).
set -euo pipefail

refuse() {
  echo "guarded-rm: отказ, ничего не удалено — $1" >&2
  exit 1
}
trap 'echo "guarded-rm: отказ, ничего не удалено — внутренняя ошибка (строка $LINENO)" >&2' ERR

SELF_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P) || refuse "не найден каталог скрипта"
WORKSPACE=$(cd "$SELF_DIR/../.." 2>/dev/null && pwd -P) || refuse "не найден корень рабочего пространства"
REGISTRY="$WORKSPACE/.claude/config/guarded-rm-roots.txt"
[ -r "$REGISTRY" ] || refuse "нет реестра корней $REGISTRY"

WINDOWS=0
command -v cygpath >/dev/null 2>&1 && WINDOWS=1

# cygpath -m keeps short 8.3 names (RUNNER~1), even if the same registry
# root is written with the long name. We expand them for the existing ancestor; the suffix
# of a nonexistent target is left so that `rm -rf` keeps its usual semantics.
windows_long_path() {
  local path=$1 parent name suffix='' long
  parent=$(cygpath -u -- "$path") || return 1
  while [ ! -e "$parent" ] && [ ! -L "$parent" ]; do
    case "$parent" in
      */?*)
        name=${parent##*/}
        parent=${parent%/*}
        [ -n "$parent" ] || parent=/
        suffix="/$name$suffix"
        ;;
      *) return 1 ;;
    esac
  done
  long=$(cygpath -m -l -- "$parent") || return 1
  printf '%s%s' "${long%/}" "$suffix"
}

# Canonical path: links and `..` resolved; on Windows — long form C:/…, lowercase.
canon() {
  local path=$1 out
  if realpath -m -- / >/dev/null 2>&1; then
    out=$(realpath -m -- "$path") || return 1
  else
    # issue #1005: emulate `realpath -m`, segment by segment. Existing parts are
    # resolved with symlinks expanded (so `link/..` means the parent of the
    # link target, as on Linux); parts that do not exist yet are appended literally.
    # The old code looked only one level up, so a target with two or more
    # missing levels was refused on macOS while the same call passed on Linux.
    out=$(perl -MCwd=realpath,getcwd -MFile::Basename -e '
      # A symlink (even a dangling one) is replaced by its target and the walk
      # continues from there; depth is capped against link loops.
      sub canon_path {
        my ($p, $depth) = @_;
        exit 1 if $depth > 40;
        my $cur = $p =~ m{^/} ? "/" : realpath(getcwd());
        exit 1 unless defined $cur;
        for my $seg (split m{/}, $p) {
          next if $seg eq "" || $seg eq ".";
          if ($seg eq "..") { $cur = dirname($cur); next; }
          my $cand = $cur eq "/" ? "/$seg" : "$cur/$seg";
          if (-l $cand) {
            my $t = readlink($cand);
            exit 1 unless defined $t;
            $t = "$cur/$t" unless $t =~ m{^/};
            $cur = canon_path($t, $depth + 1);
          } elsif (-e $cand) {
            my $r = realpath($cand);
            $cur = defined $r ? $r : $cand;
          } else {
            $cur = $cand;
          }
        }
        return $cur;
      }
      print canon_path($ARGV[0], 0);
    ' -- "$path") || return 1
  fi
  if [ "$WINDOWS" = 1 ]; then
    out=$(windows_long_path "$out") || return 1
    out=$(printf '%s' "$out" | tr '[:upper:]' '[:lower:]') || return 1
  fi
  [ -n "$out" ] || return 1
  printf '%s' "${out%/}"
}

ROOTS=()
while IFS= read -r line || [ -n "$line" ]; do
  line=${line%%#*}
  # Whitespace trimming with shell means — no external programs.
  line=${line#"${line%%[![:space:]]*}"}
  line=${line%"${line##*[![:space:]]}"}
  [ -n "$line" ] || continue
  temp_token=0
  case "$line" in
    /|[A-Za-z]:|[A-Za-z]:/|//*) refuse "корень реестра — корень файловой системы или диска: $line" ;;
    "{TMP}") root=/tmp; temp_token=1 ;;
    "{TMPDIR}") root=${TMPDIR:-}; [ -n "$root" ] || continue; temp_token=1 ;;
    "{WORKSPACE}"/*) root="$WORKSPACE${line#\{WORKSPACE\}}" ;;
    /*|[A-Za-z]:/*) root=$line ;;
    *) refuse "непонятная запись реестра: $line" ;;
  esac
  root=$(canon "$root") || refuse "не нормализуется корень реестра: $line"
  # The FS root and a drive root are never a deletion root (canon returns an empty string for `/`).
  case "$root" in
    ""|[a-z]:) refuse "корень реестра — корень файловой системы или диска: $line → ${root:-/}" ;;
  esac
  # At least two path parts after normalization: `/c`, `/home` are too broad roots.
  # Exception — the temp directory labels themselves: `{TMP}` on Linux is `/tmp`, one part by nature.
  if [ "$temp_token" != 1 ]; then
    case "$root" in
      */?*/?*) ;;
      [a-z]:/?*/?*) ;;
      *) refuse "корень реестра — корень файловой системы или диска: $line → $root" ;;
    esac
  fi
  ROOTS+=("$root")
done < "$REGISTRY"
[ "${#ROOTS[@]}" -gt 0 ] || refuse "реестр корней пуст"

inside_root() {
  local path=$1 root
  for root in "${ROOTS[@]}"; do
    case "$path" in
      "$root"/*) return 0 ;;
    esac
  done
  return 1
}

options=1
targets=0
for arg in "$@"; do
  if [ "$options" = 1 ]; then
    case "$arg" in
      --) options=0; continue ;;
      --no-preserve-root) refuse "--no-preserve-root" ;;
      -?*) continue ;;
    esac
  fi
  [ -n "$arg" ] || refuse "пустая цель (пустая переменная?)"
  path=$(canon "$arg") || refuse "не нормализуется путь: $arg"
  for root in "${ROOTS[@]}"; do
    [ "$path" != "$root" ] || refuse "цель — сам разрешённый корень: $arg"
  done
  inside_root "$path" || refuse "вне разрешённых корней: $arg → $path (реестр: $REGISTRY)"
  targets=$((targets + 1))
  # BSD rm stops parsing options at the first operand. A later -name is a
  # filename, so every subsequent argument must pass the same path check.
  options=0
done

REAL_RM=/usr/bin/rm
[ -x "$REAL_RM" ] || REAL_RM=/bin/rm
[ -x "$REAL_RM" ] || refuse "не найден rm"
exec "$REAL_RM" "$@"
