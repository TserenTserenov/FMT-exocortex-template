#!/usr/bin/env bash
# guarded-rm — rm, which deletes only within allowed roots (issue #940).
#
# Hook destructive-guard blocks the ordinary `rm` with recursive and force flags;
# instead the agent calls this script with the same arguments. The script at execution time,
# after the shell has already expanded variables and filename patterns, computes the canonical path
# of each target (symlinks and `..` expanded, forms Windows `C:/…`, `/c/…`, `/tmp/…` normalized
# to a single form) and checks it against the roots registry at component boundary. Deletes, only if
# ALL targets are located inside the roots; the root itself, a path outside the roots, an empty target, a registry failure
# or normalization failure — abort without deleting. Then a single call to the real rm with the original rm with the original
# arguments (canonical path — for verification only).
#
# Registry: <IWE>/.claude/config/guarded-rm-roots.txt — data, not shell.
# Strict mode: any unexpected error — exit before deletion (review Codex, round 1:
# failure sed when reading the registry did not stop the deletion).
set -euo pipefail

refuse() {
  echo "guarded-rm: aborted, nothing deleted — $1" >&2
  exit 1
}
trap 'echo "guarded-rm: aborted, nothing deleted — internal error (line $LINENO)" >&2' ERR

SELF_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P) || refuse "script directory not found"
WORKSPACE=$(cd "$SELF_DIR/../.." 2>/dev/null && pwd -P) || refuse "workspace root not found"
REGISTRY="$WORKSPACE/.claude/config/guarded-rm-roots.txt"
[ -r "$REGISTRY" ] || refuse "roots registry not found $REGISTRY"

WINDOWS=0
command -v cygpath >/dev/null 2>&1 && WINDOWS=1

# cygpath -m preserves short 8.3-names (RUNNER~1), even if the same root
# registry entry is recorded with a long name. Resolve them at an existing ancestor; suffix; suffix
# we leave the non-existent target as-is, so that `rm -rf` preserves normal semantics.
windows_long_path() {
  local path=$1 parent name suffix='' long
  parent=$(cygpath -u -- "$path") || return 1
  while [ ! -e "$parent" ] && [ ! -L "$parent" ]; do
    case "$parent" in
      */?*)
        name=${parent##*/}
        parent=${parent%/*}
        [ -n "$parent" ] || parent=/
        suffix="/$name$suffix"
        ;;
      *) return 1 ;;
    esac
  done
  long=$(cygpath -m -l -- "$parent") || return 1
  printf '%s%s' "${long%/}" "$suffix"
}

# Canonical path: symlinks and `..` resolved; on Windows — long form C:/…, lowercase.
canon() {
  local path=$1 out
  if realpath -m -- / >/dev/null 2>&1; then
    out=$(realpath -m -- "$path") || return 1
  else
    # issue #1005: emulate `realpath -m`, segment by segment. Existing parts are
    # resolved with symlinks expanded (so `link/..` means the parent of the
    # link target, as on Linux); parts that do not exist yet are appended literally.
    # The old code looked only one level up, so a target with two or more
    # missing levels was refused on macOS while the same call passed on Linux.
    out=$(perl -MCwd=realpath,getcwd -MFile::Basename -e '
      # A symlink (even a dangling one) is replaced by its target and the walk
      # continues from there; depth is capped against link loops.
      sub canon_path {
        my ($p, $depth) = @_;
        exit 1 if $depth > 40;
        my $cur = $p =~ m{^/} ? "/" : realpath(getcwd());
        exit 1 unless defined $cur;
        for my $seg (split m{/}, $p) {
          next if $seg eq "" || $seg eq ".";
          if ($seg eq "..") { $cur = dirname($cur); next; }
          my $cand = $cur eq "/" ? "/$seg" : "$cur/$seg";
          if (-l $cand) {
            my $t = readlink($cand);
            exit 1 unless defined $t;
            $t = "$cur/$t" unless $t =~ m{^/};
            $cur = canon_path($t, $depth + 1);
          } elsif (-e $cand) {
            my $r = realpath($cand);
            $cur = defined $r ? $r : $cand;
          } else {
            $cur = $cand;
          }
        }
        return $cur;
      }
      print canon_path($ARGV[0], 0);
    ' -- "$path") || return 1
  fi
  if [ "$WINDOWS" = 1 ]; then
    out=$(windows_long_path "$out") || return 1
    out=$(printf '%s' "$out" | tr '[:upper:]' '[:lower:]') || return 1
  fi
  [ -n "$out" ] || return 1
  printf '%s' "${out%/}"
}

ROOTS=()
while IFS= read -r line || [ -n "$line" ]; do
  line=${line%%#*}
  # Whitespace trimming using shell built-ins — no external tools.
  line=${line#"${line%%[![:space:]]*}"}
  line=${line%"${line##*[![:space:]]}"}
  [ -n "$line" ] || continue
  temp_token=0
  case "$line" in
    /|[A-Za-z]:|[A-Za-z]:/|//*) refuse "registry root — filesystem root or drive root: $line" ;;
    "{TMP}") root=/tmp; temp_token=1 ;;
    "{TMPDIR}") root=${TMPDIR:-}; [ -n "$root" ] || continue; temp_token=1 ;;
    "{WORKSPACE}"/*) root="$WORKSPACE${line#\{WORKSPACE\}}" ;;
    /*|[A-Za-z]:/*) root=$line ;;
    *) refuse "unrecognized registry entry: $line" ;;
  esac
  root=$(canon "$root") || refuse "registry root cannot be normalized: $line"
  # Filesystem root and drive root are never a valid deletion root (canon returns for `/` an empty string).
  case "$root" in
    ""|[a-z]:) refuse "registry root — filesystem root or drive root: $line → ${root:-/}" ;;
  esac
  # At least two path components after normalization: `/c`, `/home` — too broad roots.
  # Exception — the temporary directory tokens themselves: `{TMP}` on Linux is `/tmp`, a single component by nature.
  if [ "$temp_token" != 1 ]; then
    case "$root" in
      */?*/?*) ;;
      [a-z]:/?*/?*) ;;
      *) refuse "registry root — filesystem root or drive root: $line → $root" ;;
    esac
  fi
  ROOTS+=("$root")
done < "$REGISTRY"
[ "${#ROOTS[@]}" -gt 0 ] || refuse "roots registry is empty"

inside_root() {
  local path=$1 root
  for root in "${ROOTS[@]}"; do
    case "$path" in
      "$root"/*) return 0 ;;
    esac
  done
  return 1
}

options=1
targets=0
for arg in "$@"; do
  if [ "$options" = 1 ]; then
    case "$arg" in
      --) options=0; continue ;;
      --no-preserve-root) refuse "--no-preserve-root" ;;
      -?*) continue ;;
    esac
  fi
  [ -n "$arg" ] || refuse "empty target (empty variable?) (empty variable?)"
  path=$(canon "$arg") || refuse "path cannot be normalized: $arg"
  for root in "${ROOTS[@]}"; do
    [ "$path" != "$root" ] || refuse "target — the resolved root itself: $arg"
  done
  inside_root "$path" || refuse "outside allowed roots: $arg → $path (registry: $REGISTRY)"
  targets=$((targets + 1))
  # BSD rm stops parsing options at the first operand. A later -name is a
  # filename, so every subsequent argument must pass the same path check.
  options=0
done

REAL_RM=/usr/bin/rm
[ -x "$REAL_RM" ] || REAL_RM=/bin/rm
[ -x "$REAL_RM" ] || refuse "not found rm"
exec "$REAL_RM" "$@"
