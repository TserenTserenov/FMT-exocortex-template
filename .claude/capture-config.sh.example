#!/bin/bash
# capture-config.sh.example — template of the user configuration for capture_writer.sh.
#
# To activate: copy to `.claude/capture-config.sh` (without `.example`)
# and adapt to your repo structure. The file is outside FMT updates (update.sh does not
# touch it) — it is a local override.
#
# Default behavior (without the file):
#   agent_incident → written to `<target_repo>/inbox/incident-log-YYYY-MM.md`,
#   where target_repo is determined by the detector (HD "Log next to the executor",
#   DP.D.049). This means incidents are scattered across the repos where they happened.
#
# Why override: if you have a separate governance repo for aggregating
# incidents (pattern monitoring, retrospectives), set the path — and all
# agent_incident entries will flow there.

# Example: aggregation into your own governance repo (adapt the path).
# export INCIDENT_TARGET_REPO="${IWE_ROOT:-$HOME/IWE}/<your-governance-repo>"
# export INCIDENT_REL_DIR="incidents"
