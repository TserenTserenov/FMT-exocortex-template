#!/usr/bin/env bash
# .githooks/post-commit
# Part of WP-453: Pipeline for updating section 7 of the guide
# Trigger T3: explicit marker [guide-update: S7.SS_N] in the commit message.
# Trigger T1: promotion of a practice with the label [guide-impact: S7.SS_N] in the file.
#
# Called AFTER the commit is created: HEAD is already the new commit — section-state.yaml
# gets the correct SHA (in commit-msg the previous commit's SHA was used — a bug,
# found by Codex in peer session 2026-07-31-22-wp453-t3-hook-test). Plus: a failure of
# another hook before the commit completes no longer leaves a false trigger.
#
# The T3 and T1 blocks are independent: the absence of one script does not disable the other,
# the only exit 0 is at the end (Codex, peer session 2026-08-01).

set -uo pipefail  # without -e: a failure of the side pipeline must not break the git flow

REGISTRY_REPO="${IWE_REGISTRY_REPO:-${IWE_WORKSPACE:-$HOME/IWE}/${IWE_GOVERNANCE_REPO:-DS-strategy}}"
REPO_DIR=$(git rev-parse --show-toplevel 2>/dev/null || echo "")

COMMIT_MSG=$(git log -1 --pretty=%B 2>/dev/null || echo "")
COMMIT_SHA=$(git rev-parse HEAD 2>/dev/null || echo "")

# === T3: explicit marker in the commit message ===
T3_SCRIPT="${REGISTRY_REPO}/scripts/fp453-t3-mark-guide-update.sh"
if [[ -f "$T3_SCRIPT" ]]; then
  if ! "$T3_SCRIPT" "$COMMIT_MSG" "$COMMIT_SHA"; then
    # We do not block (post-commit must not break a commit because of
    # an external registry repo), but we do not stay silent either (Codex, 2026-07-31-22).
    echo "WARN: WP-453 T3 trigger failed for commit ${COMMIT_SHA:0:8} — см. $T3_SCRIPT" >&2
  fi
fi

# === T1: the [guide-impact] label in committed blobs ===
# We scan ALL added/modified files of the commit, rather than filtering by the word
# "promote" in the subject: a manual message may differ, and the cost of scanning
# with a small number of files is negligible (Codex, 2026-08-01). Merge commits
# are skipped (diff-tree on a merge without -m is empty; promotions are not done by merges).
T1_SCRIPT="${REGISTRY_REPO}/scripts/fp453-t1-check-guide-impact.sh"
if [[ -f "$T1_SCRIPT" && -n "$REPO_DIR" ]]; then
  PARENTS=$(git rev-list --parents -n 1 HEAD 2>/dev/null | wc -w | tr -d ' ')
  if [[ "$PARENTS" -le 2 ]]; then
    git diff-tree --root --no-commit-id -r --diff-filter=ACMR -z --name-only HEAD 2>/dev/null \
      | while IFS= read -r -d '' path; do
          # Skip files >1MB (labels live in the text files of practices)
          size=$(git cat-file -s "HEAD:$path" 2>/dev/null || echo 0)
          [[ "$size" -gt 1048576 ]] && continue
          if ! "$T1_SCRIPT" "$REPO_DIR" "$path"; then
            echo "WARN: WP-453 T1 trigger failed for $path — см. $T1_SCRIPT" >&2
          fi
        done
  fi
fi

exit 0
