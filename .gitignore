DS-exocortex-setup/

# Python virtual environment (developer-guide.md "Python-окружение")
.venv/

# Exocortex configuration (generated by setup.sh, contains user paths)
.exocortex.env

# 3-way merge base file for CLAUDE.md (generated by update.sh)
.claude.md.base

# Transaction marker retained only while an update needs recovery (#389)
.update-incomplete

# Claude Code — персональные файлы (не входят в шаблон)
.claude/settings.local.json
.claude/checkpoint.md
.claude/logs/

# Runtime state агента (consent-sentinel'ы WP Gate, пишет create-wp.sh) — issue #250
.claude/state/

# Author-local downstream config for sync-communication-style.py (WP-388)
scripts/sync-communication-style.yaml

# Audit run logs (iwe-audit.sh) — issue #266, previously committed by accident
scripts/*.log

# Backup copies created by skill-promote.sh — local safety net, not for git
.backups/

# macOS metadata
.DS_Store
__pycache__/
*.pyc

# issue #348: params.yaml — пространство настройки пользователя, а не файл шаблона.
# В репозитории живёт только образец params.yaml.example; рабочий файл создаётся
# при установке и никогда не приезжает из git.
/params.yaml

# WP-529 Ф3: release-receipt.sh output — generated per-run in CI (uploaded as
# an artifact, not committed) and by any local dry-run of the script.
/release-receipt.json

# issue #906: the platform creates runtime state under .iwe-runtime/ as it
# works (session-transition-locks/, hot-file-locks/, sessions/, and whatever
# comes next) but the template shipped no ignore rule for that root at all --
# every new runtime subdirectory was a fresh, unignored `git status` surprise
# for every user. Ignore the whole root, carve out the two paths that live
# there on purpose (hot-files.list, roles/).
/.iwe-runtime/*
!/.iwe-runtime/hot-files.list
!/.iwe-runtime/roles/
