# Exocortex Parameters (пользовательские настройки)
#
# Этот файл содержит персистентные параметры, влияющие на поведение протоколов.
# update.sh НЕ перезаписывает этот файл — ваши настройки в безопасности.
#
# Формат: YAML. Протоколы читают params.yaml и адаптируют поведение.

# === Протоколы ===

# Day Open: проверка видео за предыдущий день
video_check: true

# Day Open: источник календаря (issue #942)
#   connector — календарный коннектор claude.ai, затем scripts/server-calendar.sh (по умолчанию, ключ не задан = connector)
#   script    — только scripts/server-calendar.sh (нужен файл ключей Google)
#   none      — календарь не используется: без проверки, без секции в DayPlan, коннектор не подключается
calendar_source: connector

# Day Open: стиль заголовков секций в DayPlan (issue #496)
#   details  — <details><summary> (по умолчанию; сворачивается в GitHub/VS Code,
#               раскрывается как HTML-текст в Obsidian и похожих markdown-вьюерах)
#   markdown — заголовки `## ` (не сворачиваются нигде, но читаемы везде)
# Валидатор (.claude/hooks/protocol-artifact-validate.sh) принимает оба варианта.
# Пока применяется только к day-open-scaffold.sh; build-active-wp.py и
# day-open-llm-fill.py всё ещё печатают details независимо от этого параметра.
dayplan_weekplan_heading_style: details

# Day Close: расчёт мультипликатора IWE (требует WakaTime API key)
multiplier_enabled: true

# Day Close: рефлексия (вопросы в конце дня)
reflection_enabled: false

# Week Close: ротация уроков в MEMORY.md
lesson_rotation: true

# Week Close §7a/7b: место бэкапа (issue #880)
#   Пусто (ключ не задан) — дефолт: iCloud Drive на macOS, нет бэкапа на других ОС.
#   Непустое значение — свой путь; перекрывает iCloud-дефолт. Встроенный бэкап
#   и проверка его свежести работают с ним на любой ОС (macOS, Linux, WSL);
#   папка создаётся при первом бэкапе (issue #1349).
#   Пример: "~/Dropbox/IWE-backups"
backup_dir: ""

# Week Close §7a/7b: встроенный бэкап и его проверка (issue #880).
#   true  — встроенная проверка + бэкап выполняются (по умолчанию)
#   false — пропустить оба шага целиком (свой бэкап через расширение
#           week-close.after.*.md — встроенный шаг тогда не нужен и не мешает)
backup_enabled: true

# === Верификация ===

# Автоматическая верификация кода через sub-agent Haiku
auto_verify_code: true

# Верификация Quick Close через sub-agent Haiku
verify_quick_close: true

# === Уведомления ===

# Telegram уведомления от ролей (strategist, extractor, synchronizer)
telegram_notifications: true

# Путь к кастомному скрипту уведомлений (issue #17, Linux/Docker).
# Если не задан — используется встроенный macOS osascript.
# Скрипт получает: $1=title $2=message и должен вернуть exit 0.
notify_sh_path: ""

# === MCP / Capture ===

# Уровень инициативы агента при Capture-to-Pack (WP-189 Ф2):
#   manual  — только по явной команде пользователя
#   propose — агент предлагает capture, пользователь подтверждает одним кликом (default)
#   auto    — агент пишет без подтверждения
capture_autonomy: propose

# === Интеграции ===

# Путь к скрипту синхронизации Linear (day-close.sh шаг 3)
# Пустой или отсутствует → шаг пропускается
# Пример: "~/IWE/path/to/linear-sync.sh"
linear_sync_path: ""

# Необязательная проекция локальных РП во внешний трекер. Локальный контекст
# всегда остаётся источником истины; пустой allowlist запрещает внешние записи.
external_tracker:
  adapter: none # none | github_issues
  failure_policy: preserve_local
  source_of_truth: iwe
  github:
    owner: ""
    repositories: []

# === Стратег: модели фоновых сценариев (issue #1092) ===

# Алиасы модели для фоновых сценариев Стратега (roles/strategist/scripts/strategist.sh).
# Отсутствующий ключ = прежнее поведение (значения ниже и есть эти прежние дефолты).
# Пустое значение — ошибка конфигурации, не тихий откат к дефолту.
scheduler_model_week_review: claude-opus-4-7
scheduler_model_session_prep: claude-sonnet-4-6
scheduler_model_day_plan: claude-sonnet-4-6
scheduler_model_day_close: claude-sonnet-4-6
scheduler_model_note_review: claude-haiku-4-5-20251001

# === Расширения ===

# Директория с пользовательскими расширениями протоколов
extensions_dir: extensions

# === Накопительный черновик недельного поста (S-19) ===

# Путь к репозиторию knowledge-index (относительно WORKSPACE_DIR).
# Используется week-draft-init.sh + week-draft-append.sh для накопления
# материала к недельному посту.
# Пустая строка → скрипты пропускаются (фича не активирована).
# Пример: knowledge_repo: "DS-Knowledge-Index"
knowledge_repo: ""

# === Автор шаблона ===

# Авторский режим: разрешает прямое редактирование L1 файлов (protocol-*, skills/)
# Включать ТОЛЬКО если вы — автор шаблона (source-of-truth в вашем IWE,
# пропагация в FMT через template-sync.sh)
# Для обычных пользователей: false (кастомизация только через extensions/)
author_mode: false
