# Exocortex Parameters (пользовательские настройки)
#
# Этот файл содержит персистентные параметры, влияющие на поведение протоколов.
# update.sh НЕ перезаписывает этот файл — ваши настройки в безопасности.
#
# Формат: YAML. Протоколы читают params.yaml и адаптируют поведение.

# === Протоколы ===

# Day Open: проверка видео за предыдущий день
video_check: true

# Day Close: расчёт мультипликатора IWE (требует WakaTime API key)
multiplier_enabled: true

# Day Close: рефлексия (вопросы в конце дня)
reflection_enabled: false

# Week Close: ротация уроков в MEMORY.md
lesson_rotation: true

# === Верификация ===

# Автоматическая верификация кода через sub-agent Haiku
auto_verify_code: true

# Верификация Quick Close через sub-agent Haiku
verify_quick_close: true

# === Уведомления ===

# Telegram уведомления от ролей (strategist, extractor, synchronizer)
telegram_notifications: true

# Путь к кастомному скрипту уведомлений (issue #17, Linux/Docker).
# Если не задан — используется встроенный macOS osascript.
# Скрипт получает: $1=title $2=message и должен вернуть exit 0.
notify_sh_path: ""

# === MCP / Capture ===

# Уровень инициативы агента при Capture-to-Pack (WP-189 Ф2):
#   manual  — только по явной команде пользователя
#   propose — агент предлагает capture, пользователь подтверждает одним кликом (default)
#   auto    — агент пишет без подтверждения
capture_autonomy: propose

# === Интеграции ===

# Путь к скрипту синхронизации Linear (day-close.sh шаг 3)
# Пустой или отсутствует → шаг пропускается
# Пример: "~/IWE/path/to/linear-sync.sh"
linear_sync_path: ""

# Необязательная проекция локальных РП во внешний трекер. Локальный контекст
# всегда остаётся источником истины; пустой allowlist запрещает внешние записи.
external_tracker:
  adapter: none # none | github_issues
  failure_policy: preserve_local
  source_of_truth: iwe
  github:
    owner: ""
    repositories: []

# === Расширения ===

# Директория с пользовательскими расширениями протоколов
extensions_dir: extensions

# === Накопительный черновик недельного поста (S-19) ===

# Путь к репозиторию knowledge-index (относительно WORKSPACE_DIR).
# Используется week-draft-init.sh + week-draft-append.sh для накопления
# материала к недельному посту.
# Пустая строка → скрипты пропускаются (фича не активирована).
# Пример: knowledge_repo: "DS-Knowledge-Index"
knowledge_repo: ""

# === Автор шаблона ===

# Авторский режим: разрешает прямое редактирование L1 файлов (protocol-*, skills/)
# Включать ТОЛЬКО если вы — автор шаблона (source-of-truth в вашем IWE,
# пропагация в FMT через template-sync.sh)
# Для обычных пользователей: false (кастомизация только через extensions/)
author_mode: false
